{
  "manifest_version": 3,
  "name": "PLaMo Paper Translator Launcher",
  "version": "1.3.2",
  "description": "PLaMo Paper Translatorを起動してローカル画面を開きます。",
  "key": "",
  "minimum_chrome_version": "99",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:7865/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PLaMo Paper Translatorを再起動して開く",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "open-plamo": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "PLaMo Paper Translatorを再起動して開く"
    }
  }
}
